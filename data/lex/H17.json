":7},"H1754":{"lemma":"דּוּר","xlit":"dûwr","pron":"dure","from":"from H1752 (דּוּר);","def":"a circle, ball or pile","kjv":"ball, turn, round about.","count":2},"H1755":{"lemma":"דּוֹר","xlit":"dôwr","pron":"dore","from":"or (shortened) דֹּר; from H1752 (דּוּר);","def":"properly, a revolution of time, i.e. an age or generation; also a dwelling","kjv":"age, [idiom] evermore, generation, (n-) ever, posterity.","count":167},"H1756":{"lemma":"דּוֹר","xlit":"Dôwr","pron":"dore","from":"or (by permutation) דֹּאר; (Joshua 17:11; 1 Kings 4:11), from H1755 (דּוֹר); dwelling;","def":"Dor, a place in Palestine","kjv":"Dor.","count":7},"H1757":{"lemma":"דּוּרָא","xlit":"Dûwrâʼ","pron":"doo-raw'","from":"(Aramaic) probably from H1753 (דּוּר); circle or dwelling;","def":"Dura, a place in Babylonia","kjv":"Dura.","count":1},"H1758":{"lemma":"דּוּשׁ","xlit":"dûwsh","pron":"doosh","from":"or דּוֹשׁ; or דִּישׁ; a primitive root;","def":"to trample or thresh","kjv":"break, tear, thresh, tread out (down), at grass (Jeremiah 50:11, by mistake for H1877 (דֶּשֶׁא)).","count":16},"H1759":{"lemma":"דּוּשׁ","xlit":"dûwsh","pron":"doosh","from":"(Aramaic) corresponding to H1758 (דּוּשׁ);","def":"to trample","kjv":"tread down.","count":1},"H1760":{"lemma":"דָּחָה","xlit":"dâchâh","pron":"daw-khaw'","from":"or דָּחַח; (Jeremiah 23:12), a primitive root;","def":"to push down","kjv":"chase, drive away (on), overthrow, outcast, [idiom] sore, thrust, totter.","count":8},"H1761":{"lemma":"דַּחֲוָה","xlit":"dachăvâh","pron":"dakh-av-aw'","from":"(Aramaic) from the equivalent of H1760 (דָּחָה);","def":"probably a musical instrument (as being struck)","kjv":"instrument of music.","count":1},"H1762":{"lemma":"דְּחִי","xlit":"dᵉchîy","pron":"deh-khee'","from":"from H1760 (דָּחָה);","def":"a push, i.e. (by implication) a fall","kjv":"falling.","count":2},"H1763":{"lemma":"דְּחַל","xlit":"dᵉchal","pron":"deh-khal'","from":"(Aramaic) corresponding to H2119 (זָחַל);","def":"to slink, i.e. (by implication) t