{"H8600":{"lemma":"תְּפוֹצָה","xlit":"tᵉphôwtsâh","pron":"tef-o-tsaw'","from":"from H6327 (פּוּץ);","def":"a dispersal","kjv":"dispersion.","count":1},"H8601":{"lemma":"תֻּפִין","xlit":"tuphîyn","pron":"too-feen'","from":"from H644 (אָפָה);","def":"cookery, i.e. (concretely) a cake","kjv":"baked piece.","count":1},"H8602":{"lemma":"תָּפֵל","xlit":"tâphêl","pron":"taw-fale'","from":"from an unused root meaning to smear;","def":"plaster (as gummy) or slime; (figuratively) frivolity","kjv":"foolish things, unsavoury, untempered.","count":7},"H8603":{"lemma":"תֹּפֶל","xlit":"Tôphel","pron":"to'-fel","from":"from the same as H8602 (תָּפֵל); quagmire;","def":"Tophel, a place near the Desert","kjv":"Tophel.","count":1},"H8604":{"lemma":"תִּפְלָה","xlit":"tiphlâh","pron":"tif-law'","from":"from the same as H8602 (תָּפֵל);","def":"frivolity","kjv":"folly, foolishly.","count":3},"H8605":{"lemma":"תְּפִלָּה","xlit":"tᵉphillâh","pron":"tef-il-law'","from":"from H6419 (פָּלַל);","def":"intercession, supplication; by implication, a hymn","kjv":"prayer.","count":77},"H8606":{"lemma":"תִּפְלֶצֶת","xlit":"tiphletseth","pron":"tif-leh'-tseth","from":"from H6426 (פָּלַץ);","def":"fearfulness","kjv":"terrible.","count":1},"H8607":{"lemma":"תִּפְסַח","xlit":"Tiphçach","pron":"tif-sakh'","from":"from H6452 (פָּסַח); ford;","def":"Tiphsach, a place in Mesopotamia","kjv":"Tipsah.","count":2},"H8608":{"lemma":"תָּפַף","xlit":"tâphaph","pron":"taw-faf'","from":"a primitive root;","def":"to drum, i.e. play (as) on the tambourine","kjv":"taber, play with timbrels.","count":2},"H8609":{"lemma":"תָּפַר","xlit":"tâphar","pron":"taw-far'","from":"a primitive root;","def":"to sew","kjv":"(women that) sew (together).","count":4},"H8610":{"lemma":"תָּפַשׂ","xlit":"tâphas","pron":"taw-fas'","from":"a primitive root;","def":"to manipulate, i.e. seize; chiefly to capture, wield, specifically, to overlay; figuratively, to use unwarrantably","kjv":"catch, handle, (lay, take) hold (on, over), stop, [idiom] surely, surprise, take.","count":65},"H8611":{"lemma":"תֹּפֶת","xlit":"tôpheth","pron":"to'-feth","from":"from the base of H8608 (תָּפַף);","def":"a smiting, i.e. (figuratively) contempt","kjv":"tabret.","count":1},"H8612":{"lemma":"תֹּפֶת","xlit":"Tôpheth","pron":"to'-feth","from":"the same as H8611 (תֹּפֶת);","def":"Topheth, a place near Jerusalem","kjv":"Tophet, Topheth.","count":9},"H8613":{"lemma":"תׇּפְתֶּה","xlit":"Tophteh","pron":"tof-teh'","from":"probably a form of H8612 (תֹּפֶת);","def":"Tophteh, a place of cremation","kjv":"Tophet.","count":1},"H8614":{"lemma":"תִּפְתַּי","xlit":"tiphtay","pron":"tif-tah'-ee","from":"(Aramaic) perhaps from H8199 (שָׁפַט);","def":"judicial, i.e. a lawyer","kjv":"sheriff.","count":2},"H8615":{"lemma":"תִּקְוָה","xlit":"tiqvâh","pron":"tik-vaw'","from":"from H6960 (קָוָה); (compare H6961 (קָוֶה))","def":"literally a cord (as an attachment); figuratively, expectancy","kjv":"expectation(-ted), hope, live, thing that I long for.","count":34},"H8616":{"lemma":"תִּקְוָה","xlit":"Tiqvâh","pron":"tik-vaw'","from":"the same as H8615 (תִּקְוָה);","def":"Tikvah, the name of two Israelites","kjv":"Tikvah.","count":3},"H8617":{"lemma":"תְּקוּמָה","xlit":"tᵉqûwmâh","pron":"tek-oo-maw'","from":"from H6965 (קוּם);","def":"resistfulness","kjv":"power to stand.","count":1},"H8618":{"lemma":"תְּקוֹמֵם","xlit":"tᵉqôwmêm","pron":"tek-o-mame'","from":"from H6965 (קוּם);","def":"an opponent","kjv":"rise up against.","count":1},"H8619":{"lemma":"תָּקוֹעַ","xlit":"tâqôwaʻ","pron":"taw-ko'-ah","from":"from H8628 (תָּקַע) (in the musical sense);","def":"a trumpet","kjv":"trumpet.","count":1},"H8620":{"lemma":"תְּקוֹעַ","xlit":"Tᵉqôwaʻ","pron":"tek-o'-ah","from":"a form of H8619 (תָּקוֹעַ);","def":"Tekoa, a place in Palestine","kjv":"Tekoa, Tekoah.","count":7},"H8621":{"lemma":"תְּקוֹעִי","xlit":"Tᵉqôwʻîy","pron":"tek-o-ee'","from":"or תְּקֹעִי; patronymically from H8620 (תְּקוֹעַ);","def":"a Tekoite or inhabitant of Tekoah","kjv":"Tekoite.","count":7},"H8622":{"lemma":"תְּקוּפָה","xlit":"tᵉqûwphâh","pron":"tek-oo-faw'","from":"or תְּקֻפָה; from H5362 (נָקַף);","def":"a revolution, i.e. (of the sun) course, (of time) lapse","kjv":"circuit, come about, end.","count":4},"H8623":{"lemma":"תַּקִּיף","xlit":"taqqîyph","pron":"tak-keef'","from":"from H8630 (תָּקַף);","def":"powerful","kjv":"mightier.","count":1},"H8624":{"lemma":"תַּקִּיף","xlit":"taqqîyph","pron":"tak-keef'","from":"(Aramaic) corresponding to H8623 (תַּקִּיף)","def":"{powerful}","kjv":"mighty, strong.","count":5},"H8625":{"lemma":"תְּקַל","xlit":"tᵉqal","pron":"tek-al'","from":"(Aramaic) corresponding to H8254 (שָׁקַל);","def":"to balance","kjv":"Tekel, be weighed.","count":3},"H8626":{"lemma":"תָּקַן","xlit":"tâqan","pron":"taw-kan'","from":"a primitive root;","def":"to equalize, i.e. straighten (intransitive or transitive); figuratively, to compose","kjv":"set in order, make straight.","count":3},"H8627":{"lemma":"תְּקַן","xlit":"tᵉqan","pron":"tek-an'","from":"(Aramaic) corresponding to H8626 (תָּקַן);","def":"to straighten up, i.e. confirm","kjv":"establish.","count":1},"H8628":{"lemma":"תָּקַע","xlit":"tâqaʻ","pron":"taw-kah'","from":"a primitive root;","def":"to clatter, i.e. slap (the hands together), clang (an instrument); by analogy, to drive (a nail or tent-pin, a dart, etc.); by implication, to become bondsman by handclasping)","kjv":"blow (a trumpet), cast, clap, fasten, pitch (tent), smite, sound, strike, [idiom] suretiship, thrust.","count":68},"H8629":{"lemma":"תֵּקַע","xlit":"têqaʻ","pron":"tay-kah'","from":"from H8628 (תָּקַע);","def":"a blast of a trumpet","kjv":"sound.","count":1},"H8630":{"lemma":"תָּקַף","xlit":"tâqaph","pron":"taw-kaf'","from":"a primitive root;","def":"to overpower","kjv":"prevail (against).","count":3},"H8631":{"lemma":"תְּקֵף","xlit":"tᵉqêph","pron":"tek-afe'","from":"(Aramaic) corresponding to H8630 (תָּקַף);","def":"to become (causatively, make) mighty or (figuratively) obstinate","kjv":"make firm, harden