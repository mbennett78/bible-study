{"H2200":{"lemma":"זְעִק","xlit":"zᵉʻiq","pron":"zek'-eek","from":"(Aramaic) corresponding to H2199 (זָעַק);","def":"to make an outcry","kjv":"cry.","count":1},"H2201":{"lemma":"זַעַק","xlit":"zaʻaq","pron":"zah'-ak","from":"and (feminine) זְעָקָהxlit zᵉâqâh corrected to zᵉʻâqâh; from H2199 (זָעַק);","def":"a shriek or outcry","kjv":"cry(-ing).","count":18},"H2202":{"lemma":"זִפְרֹן","xlit":"Ziphrôn","pron":"zi-frone'","from":"from an unused root (meaning to be fragrant);","def":"Ziphron, a place in Palestine","kjv":"Ziphron.","count":1},"H2203":{"lemma":"זֶפֶת","xlit":"zepheth","pron":"zeh'-feth","from":"from an unused root (meaning to liquify);","def":"asphalt (from its tendency to soften in the sun)","kjv":"pitch.","count":3},"H2204":{"lemma":"זָקֵן","xlit":"zâqên","pron":"zaw-kane'","from":"a primitive root;","def":"to be old","kjv":"aged man, be (wax) old (man).","count":27},"H2205":{"lemma":"זָקֵן","xlit":"zâqên","pron":"zaw-kane'","from":"from H2204 (זָקֵן);","def":"old","kjv":"aged, ancient (man), elder(-est), old (man, men and...women), senator.","count":178},"H2206":{"lemma":"זָקָן","xlit":"zâqân","pron":"zaw-kawn'","from":"from H2204 (זָקֵן);","def":"the beard (as indicating age)","kjv":"beard.","count":19},"H2207":{"lemma":"זֹקֶן","xlit":"zôqen","pron":"zo'-ken","from":"from H2204 (זָקֵן);","def":"old age","kjv":"age.","count":1},"H2208":{"lemma":"זָקֻן","xlit":"zâqun","pron":"zaw-koon'","from":"properly, passive participle of H2204 (זָקֵן) (used only in the plural as a noun);","def":"old age","kjv":"old age.","count":4},"H2209":{"lemma":"זִקְנָה","xlit":"ziqnâh","pron":"zik-naw'","from":"feminine of H2205 (זָקֵן);","def":"old age","kjv":"old (age).","count":6},"H2210":{"lemma":"זָקַף","xlit":"zâqaph","pron":"zaw-kaf'","from":"a primitive root;","def":"to life, i.e. (figuratively) comfort","kjv":"raise (up).","count":2},"H2211":{"lemma":"זְקַף","xlit":"zᵉqaph","pron":"zek-af'","from":"(Aramaic) corresponding to H2210 (זָקַף);","def":"to hang, i.e. impale","kjv":"set up.","count":1},"H2212":{"lemma":"זָקַק","xlit":"zâqaq","pron":"zaw-kak'","from":"a primitive root;","def":"to strain, (figuratively) extract, clarify","kjv":"fine, pour down, purge, purify, refine.","count":7},"H2213":{"lemma":"זֵר","xlit":"zêr","pron":"zare","from":"from H2237 (זָרַר) (in the sense of scattering);","def":"a chaplet (as spread around the top), i.e. (specifically) a border moulding","kjv":"crown.","count":10},"H2214":{"lemma":"זָרָא","xlit":"zârâʼ","pron":"zaw-raw'","from":"from H2114 (זוּר) (in the sense of estrangement) (compare H2219 (זָרָה));","def":"disgust","kjv":"loathsome.","count":1},"H2215":{"lemma":"זָרַב","xlit":"zârab","pron":"zaw-rab'","from":"a primitive root;","def":"to flow away","kjv":"wax warm.","count":1},"H2216":{"lemma":"זְרֻבָּבֶל","xlit":"Zᵉrubbâbel","pron":"zer-oob-baw-bel'","from":"from H2215 (זָרַב) and H894 (בָּבֶל); descended of (i.e. from) Babylon, i.e. born there;","def":"Zerubbabel, an Israelite","kjv":"Zerubbabel.","count":21},"H2217":{"lemma":"זְרֻבָּבֶל","xlit":"Zᵉrubbâbel","pron":"zer-oob-baw-bel'","from":"(Aramaic) corresponding to H2216 (זְרֻבָּבֶל)","def":"{Zerubbabel, an Israelite}","kjv":"Zerubbabel.","count":1},"H2218":{"lemma":"זֶרֶד","xlit":"Zered","pron":"zeh'-red","from":"from an unused root meaning to be exuberant in growth; lined with shrubbery;","def":"Zered, a brook East of the Dead Sea","kjv":"Zared, Zered.","count":4},"H2219":{"lemma":"זָרָה","xlit":"zârâh","pron":"zaw-raw'","from":"a primitive root (compare H2114 (זוּר));","def":"to toss about; by implication, to diffuse, winnow","kjv":"cast away, compass, disperse, fan, scatter (away), spread, strew, winnow.","count":39},"H2220":{"lemma":"זְרוֹעַ","xlit":"zᵉrôwaʻ","pron":"zer-o'-ah","from":"or (shortened) זְרֹעַ; and (feminine) זְרוֹעָה; or זְרֹעָה; from H2232 (זָרַע);","def":"the arm (as stretched out), or (of animals) the foreleg; figuratively, force","kjv":"arm, [phrase] help, mighty, power, shoulder, strength.","count":91},"H2221