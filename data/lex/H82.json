{"H8200":{"lemma":"שְׁפַט","xlit":"shᵉphaṭ","pron":"shef-at'","from":"(Aramaic) corresponding to H8199 (שָׁפַט);","def":"to judge","kjv":"magistrate.","count":1},"H8201":{"lemma":"שֶׁפֶט","xlit":"shepheṭ","pron":"sheh'-fet","from":"from H8199 (שָׁפַט);","def":"a sentence, i.e. infliction","kjv":"judgment.","count":16},"H8202":{"lemma":"שָׁפָט","xlit":"Shâphâṭ","pron":"shaw-fawt'","from":"from H8199 (שָׁפַט); judge;","def":"Shaphat, the name of four Israelites","kjv":"Shaphat.","count":8},"H8203":{"lemma":"שְׁפַטְיָה","xlit":"Shᵉphaṭyâh","pron":"shef-at-yaw'","from":"or שְׁפַטְיָהוּ; from H8199 (שָׁפַט) and H3050 (יָהּ); Jah has judged;","def":"Shephatjah, the name of ten Israelites","kjv":"Shephatiah.","count":13},"H8204":{"lemma":"שִׁפְטָן","xlit":"Shiphṭân","pron":"shif-tawn'","from":"from H8199 (שָׁפַט); judge-like;","def":"Shiphtan, an Israelite","kjv":"Shiphtan.","count":1},"H8205":{"lemma":"שְׁפִי","xlit":"shᵉphîy","pron":"shef-ee'","from":"from H8192 (שָׁפָה);","def":"bareness; concretely, a bare hill or plain","kjv":"high place, stick out.","count":9},"H8206":{"lemma":"שֻׁפִּים","xlit":"Shuppîym","pron":"shoop-peem'","from":"plural of an unused noun from the same as H8207 (שְׁפִיפֹן) and meaning the same; serpents;","def":"Shuppim, an Israelite","kjv":"Shuppim.","count":3},"H8207":{"lemma":"שְׁפִיפֹן","xlit":"shᵉphîyphôn","pron":"shef-ee-fone'","from":"from an unused root meaning the same as H7779 (שׁוּף);","def":"a kind of serpent (as snapping), probably the cerastes or horned adder","kjv":"adder.","count":1},"H8208":{"lemma":"שָׁפִיר","xlit":"Shâphîyr","pron":"shaf-eer'","from":"from H8231 (שָׁפַר); beautiful;","def":"Shaphir, a place in Palestine","kjv":"Saphir.","count":1},"H8209":{"lemma":"שַׁפִּיר","xlit":"shappîyr","pron":"shap-peer'","from":"(Aramaic) intensive of a form corresponding to H8208 (שָׁפִיר);","def":"beautiful","kjv":"fair.","count":2},"H8210":{"lemma":"שָׁפַךְ","xlit":"shâphak","pron":"shaw-fak'","from":"a primitive root;","def":"to spil