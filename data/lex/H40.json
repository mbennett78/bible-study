1},"H4012":{"lemma":"מְבֻנַּי","xlit":"Mᵉbunnay","pron":"meb-oon-hah'-ee","from":"from H1129 (בָּנָה); built up;","def":"Mebunnai, an Israelite","kjv":"Mebunnai.","count":1},"H4013":{"lemma":"מִבְצָר","xlit":"mibtsâr","pron":"mib-tsawr'","from":"also (in plural) feminine (Daniel 11:l5) מִבְצָרָה; from H1219 (בָּצַר);","def":"a fortification, castle, or fortified city; figuratively, a defender","kjv":"(de-, most) fenced, fortress, (most) strong (hold).","count":37},"H4014":{"lemma":"מִבְצָר","xlit":"Mibtsâr","pron":"mib-tsawr'","from":"the same as H4013 (מִבְצָר);","def":"Mibtsar, an Idumaean","kjv":"Mibzar.","count":2},"H4015":{"lemma":"מִבְרָח","xlit":"mibrâch","pron":"mib-rawkh'","from":"from H1272 (בָּרַח);","def":"a refugee","kjv":"fugitive.","count":1},"H4016":{"lemma":"מָבֻשׁ","xlit":"mâbush","pron":"maw-boosh'","from":"from H954 (בּוּשׁ);","def":"(plural) the (male) pudenda","kjv":"secrets.","count":1},"H4017":{"lemma":"מִבְשָׂם","xlit":"Mibsâm","pron":"mib-sawm'","from":"from the same as H1314 (בֶּשֶׂם); fragrant;","def":"Mibsam, the name of an Ishmaelite and of an Israelite","kjv":"Mibsam.","count":3},"H4018":{"lemma":"מְבַשְּׁלָה","xlit":"mᵉbashshᵉlâh","pron":"meb-ash-shel-aw'","from":"from H1310 (בָּשַׁל);","def":"a cooking hearth","kjv":"boiling-place.","count":1},"H4019":{"lemma":"מַגְבִּישׁ","xlit":"Magbîysh","pron":"mag-beesh'","from":"from the same as H1378 (גָּבִישׁ); stiffening;","def":"Magbish, an Israelite, or a place in Palestine","kjv":"Magbish.","count":1},"H4020":{"lemma":"מִגְבָּלָה","xlit":"migbâlâh","pron":"mig-baw-law'","from":"from H1379 (גָּבַל);","def":"a border","kjv":"end.","count":1},"H4021":{"lemma":"מִגְבָּעָה","xlit":"migbâʻâh","pron":"mig-baw-aw'","from":"from the same as H1389 (גִּבְעָה);","def":"a cap (as hemispherical)","kjv":"bonnet.","count":4},"H4022":{"lemma":"מֶגֶד","xlit":"meged","pron":"meh'-ghed","from":"from an unused root probably meaning to be eminent;","def":"properly, a distinguished thing; hence something valuab