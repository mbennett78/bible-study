{"H4200":{"lemma":"מֶזֶו","xlit":"mezev","pron":"meh'-zev","from":"probably from an unused root meaning to gather in;","def":"a granary","kjv":"garner.","count":1},"H4201":{"lemma":"מְזוּזָה","xlit":"mᵉzûwzâh","pron":"mez-oo-zaw'","from":"or מְזֻזָה; from the same as H2123 (זִיז);","def":"a door-post (as prominent)","kjv":"(door, side) post.","count":19},"H4202":{"lemma":"מָזוֹן","xlit":"mâzôwn","pron":"maw-zone'","from":"from H2109 (זוּן);","def":"food","kjv":"meat, victual.","count":2},"H4203":{"lemma":"מָזוֹן","xlit":"mâzôwn","pron":"maw-zone'","from":"(Aramaic) corresponding to H4202 (מָזוֹן)","def":"{food}","kjv":"meat.","count":2},"H4204":{"lemma":"מָזוֹר","xlit":"mâzôwr","pron":"maw-zore'","from":"from H2114 (זוּר) in the sense of turning aside from truth;","def":"treachery, i.e. a plot","kjv":"wound.","count":1},"H4205":{"lemma":"מָזוֹר","xlit":"mâzôwr","pron":"maw-zore'","from":"or מָזֹר; from H2115 (זוּר) in the sense of binding up;","def":"a bandage, i.e. remedy; hence, a sore (as needing a compress)","kjv":"bound up, wound.","count":3},"H4206":{"lemma":"מָזִיחַ","xlit":"mâzîyach","pron":"maw-zee'-akh","from":"or מֵזַח; from H2118 (זָחַח);","def":"a belt (as movable)","kjv":"girdle, strength.","count":3},"H4207":{"lemma":"מַזְלֵג","xlit":"mazlêg","pron":"maz-layg'","from":"or (feminine) מִזְלָגָה; from an unused root meaning to draw up;","def":"a fork","kjv":"fleshhook.","count":7},"H4208":{"lemma":"מַזָּלָה","xlit":"mazzâlâh","pron":"maz-zaw-law'","from":"apparently from H5140 (נָזַל) in the sense of raining;","def":"a constellation, i.e. Zodiacal sign (perhaps as affecting the weather)","kjv":"planet. Compare H4216 (מַזָּרָה).","count":1},"H4209":{"lemma":"מְזִמָּה","xlit":"mᵉzimmâh","pron":"mez-im-maw'","from":"from H2161 (זָמַם);","def":"a plan, usually evil (machination), sometimes good (sagacity)","kjv":"(wicked) device, discretion, intent, witty invention, lewdness, mischievous (device), thought, wickedly.","count":19},"H4210":{"lemma":"מִזְמוֹר","